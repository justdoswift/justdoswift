{
  "name": "justdoswift",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/sync-swift.mjs --check && node scripts/check-gpui-assets.mjs && tsc --noEmit",
    "sync:swift": "node scripts/sync-swift.mjs",
    "check:swift": "zsh scripts/check-swift.sh",
    "videos:render": "npm --prefix videos run render:all",
    "build:gpui": "bash scripts/build-gpui.sh",
    "dev:gpui": "cd examples/gpui-command && cargo run --locked",
    "dev:gpui:accordion": "cd examples/gpui-command && cargo run --locked -- --accordion",
    "check:gpui": "cd examples/gpui-command && cargo fmt --check && cargo test --locked --lib"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tailwindcss/postcss": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5.9.2"
  }
